{
  "name": "axisloanportfolio",
  "widgetName": "AxisLoanPortfolio",
  "version": "0.1.0",
  "description": "Tenant-scoped AXIS loan portfolio analytics",
  "copyright": "Copyright 2026 AXIS assessment contributors",
  "author": "AXIS assessment contributors",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "license": "Apache-2.0",
  "config": {
    "projectPath": "./.mendix-app",
    "mendixHost": "http://localhost:8080",
    "developmentPort": 3000
  },
  "packagePath": "axis.loanportfolio",
  "scripts": {
    "start": "pluggable-widgets-tools start:server",
    "dev": "pluggable-widgets-tools start:web",
    "build": "pluggable-widgets-tools build:web",
    "lint": "pluggable-widgets-tools lint",
    "lint:fix": "pluggable-widgets-tools lint:fix",
    "test": "pluggable-widgets-tools test:unit:web",
    "test:unit": "pluggable-widgets-tools test:unit:web",
    "prerelease": "npm run lint",
    "release": "pluggable-widgets-tools release:web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src typings \"scripts/*.cjs\" \"preview/*.mjs\"",
    "format:check": "prettier --check src typings \"scripts/*.cjs\" \"preview/*.mjs\"",
    "check": "node scripts/check.cjs",
    "preview:build": "rollup -c scripts/preview.config.cjs",
    "preview:serve": "node scripts/preview-server.cjs"
  },
  "devDependencies": {
    "@mendix/pluggable-widgets-tools": "11.15.0",
    "@types/big.js": "6.2.2",
    "@types/jest": "30.0.0"
  },
  "dependencies": {
    "big.js": "6.2.2",
    "classnames": "2.5.1"
  },
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "minimatch@<11.0.1": "^11.0.1",
    "glob@3.0.0 - 14.0.1": "^14.0.2"
  },
  "packageManager": "npm@11.20.0"
}
