# Safe example only. Copy to .env for a NEW environment; never overwrite an existing .env.
# Set MSSQL_SA_PASSWORD privately before starting SQL Server (see docs/setup.md).
MSSQL_SA_PASSWORD=
SQLSERVER_PORT=1433
SQLSERVER_HOST=127.0.0.1,1433
RISK_TEST_HOST=127.0.0.1,1433
RISK_DATABASE=LoanPortfolio
PORTFOLIO_DATABASE=LoanPortfolio
RISK_API_PORT=8000
PORTFOLIO_PORT=8081
# Provisioning generates dedicated account passwords, JWT/cursor secrets and fixture tenant IDs.
# Do not add real credentials to this example. Production authentication is not provided.
